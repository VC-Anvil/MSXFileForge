# End-to-end check of the msxforge CLI (cross-platform: plain CMake script).
#   cmake -DMSXFORGE=<path> -DDSK2DMK=<path> -DWORK=<dir> -DDATA=<dir> -P cli_smoke.cmake
cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(IMG "${WORK}/t.dsk")

function(run expect_rc)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${WORK}"
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL expect_rc)
    message(FATAL_ERROR "`${ARGN}` returned ${rc} (want ${expect_rc})\n${out}\n${err}")
  endif()
  set(OUT "${out}" PARENT_SCOPE)
endfunction()

function(expect_in needle)
  string(FIND "${OUT}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "expected '${needle}' in output:\n${OUT}")
  endif()
endfunction()

file(WRITE "${WORK}/hello.bas" "10 PRINT \"HELLO\"\n20 GOTO 10\n")
file(WRITE "${WORK}/notes.txt" "MSXFileForge smoke test\n")

run(0 "${MSXFORGE}" format "${IMG}" 720)
run(0 "${MSXFORGE}" tok "${WORK}/hello.bas" "${WORK}/HELLO.BAS")
expect_in("10 PRINT \"HELLO\"")
run(0 "${MSXFORGE}" add "${IMG}" "${WORK}/HELLO.BAS")
run(0 "${MSXFORGE}" mkdir "${IMG}" DOCS)
run(0 "${MSXFORGE}" add "${IMG}" "${WORK}/notes.txt" /DOCS README.TXT)
run(6 "${MSXFORGE}" add "${IMG}" "${WORK}/notes.txt" / WAYTOOLONGNAME.TXT)
file(WRITE "${WORK}/A Long Host Name.txt" "x\n")
run(0 "${MSXFORGE}" add "${IMG}" "${WORK}/A Long Host Name.txt")   # name derived
expect_in("ALONGH~1.TXT")
run(0 "${MSXFORGE}" ls "${IMG}" /DOCS)
expect_in("README.TXT")
run(0 "${MSXFORGE}" cat "${IMG}" docs/readme.txt)
expect_in("smoke test")
run(0 "${MSXFORGE}" detok "${IMG}" HELLO.BAS)
expect_in("20 GOTO 10")
run(0 "${MSXFORGE}" extract "${IMG}" /DOCS/README.TXT "${WORK}/out.txt")
file(READ "${WORK}/out.txt" back)
file(READ "${WORK}/notes.txt" orig)
if(NOT back STREQUAL orig)
  message(FATAL_ERROR "extracted file differs")
endif()
run(0 "${MSXFORGE}" fsck "${IMG}")
expect_in("OK")

configure_file("${IMG}" "${WORK}/copy.dsk" COPYONLY)
run(0 "${MSXFORGE}" diff "${IMG}" "${WORK}/copy.dsk")
run(0 "${MSXFORGE}" rename "${WORK}/copy.dsk" DOCS/README.TXT INFO.TXT)
run(1 "${MSXFORGE}" diff "${IMG}" "${WORK}/copy.dsk")
expect_in("only in B: /DOCS/INFO.TXT")
run(6 "${MSXFORGE}" del "${WORK}/copy.dsk" DOCS)              # not empty
run(0 "${MSXFORGE}" del "${WORK}/copy.dsk" DOCS/INFO.TXT)
run(0 "${MSXFORGE}" del "${WORK}/copy.dsk" DOCS)
run(4 "${MSXFORGE}" cat "${WORK}/copy.dsk" DOCS/INFO.TXT)
run(0 "${MSXFORGE}" fsck "${WORK}/copy.dsk")

run(0 "${DSK2DMK}" "${IMG}" "${WORK}/t.dmk")
run(0 "${MSXFORGE}" info "${WORK}/t.dmk")
expect_in("DMK")
expect_in("Protected  : no")
run(0 "${MSXFORGE}" cat "${WORK}/t.dmk" DOCS/README.TXT)
expect_in("smoke test")

configure_file("${DATA}/ascii.cas" "${WORK}/t.cas" COPYONLY)   # ASCII header + one data block
run(0 "${MSXFORGE}" cas "${WORK}/t.cas")
expect_in("ASCII file")
run(0 "${MSXFORGE}" cas2tsx "${WORK}/t.cas" "${WORK}/t.tsx")
run(0 "${MSXFORGE}" tsx2cas "${WORK}/t.tsx" "${WORK}/back.cas")
file(SHA256 "${WORK}/t.cas" h1)
file(SHA256 "${WORK}/back.cas" h2)
if(NOT h1 STREQUAL h2)
  message(FATAL_ERROR "cas -> tsx -> cas changed the bytes")
endif()
# ---- pack / unpack / undelete / attrib / label -----------------------------
file(MAKE_DIRECTORY "${WORK}/src/Sub Folder")
file(WRITE "${WORK}/src/game.bas" "10 PRINT 1\n")
file(WRITE "${WORK}/src/My Long Program Name.txt" "long name\n")
file(WRITE "${WORK}/src/Sub Folder/deep.dat" "deep data\n")
run(0 "${MSXFORGE}" pack "${WORK}/src" "${WORK}/p.dsk" 720 --label "Smoke Test")
expect_in("MYLONG~1.TXT")
expect_in("SUBFOL~1")
run(0 "${MSXFORGE}" label "${WORK}/p.dsk")
expect_in("SMOKE TEST")
run(0 "${MSXFORGE}" fsck "${WORK}/p.dsk")
run(0 "${MSXFORGE}" unpack "${WORK}/p.dsk" "${WORK}/dst")
expect_in("extracted 3 file(s)")
file(READ "${WORK}/dst/SUBFOL~1/DEEP.DAT" deep)
if(NOT deep STREQUAL "deep data\n")
  message(FATAL_ERROR "pack -> unpack changed DEEP.DAT")
endif()
run(0 "${MSXFORGE}" attrib "${WORK}/p.dsk" GAME.BAS +R +h)
expect_in("RH")
run(1 "${MSXFORGE}" attrib "${WORK}/p.dsk" GAME.BAS +X)
run(0 "${MSXFORGE}" del "${WORK}/p.dsk" SUBFOL~1/DEEP.DAT)
run(1 "${MSXFORGE}" undelete "${WORK}/p.dsk" SUBFOL~1/?EEP.DAT)   # letter needed
run(0 "${MSXFORGE}" undelete "${WORK}/p.dsk" SUBFOL~1/?EEP.DAT D)
run(0 "${MSXFORGE}" cat "${WORK}/p.dsk" SUBFOL~1/DEEP.DAT)
expect_in("deep data")
run(0 "${MSXFORGE}" fsck "${WORK}/p.dsk")
run(0 "${MSXFORGE}" label "${WORK}/p.dsk" --clear)
expect_in("removed")

message(STATUS "cli smoke test passed")
